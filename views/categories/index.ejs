<%- include('../partials/header') %>

<main class="categories-page">
    <section class="categories-shell">

        <div class="page-hero categories-hero">
            <div>
                <span class="eyebrow">Admin Panel</span>
                <h1>Categories</h1>
                <p>
                    Manage event categories to keep events organized and easy for users to browse.
                </p>
            </div>

            <a href="/categories/create" class="btn-create-category">
                + Create Category
            </a>
        </div>

        <% if (categories.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">🏷️</div>
                <h2>No Categories Yet</h2>
                <p>
                    Start by creating your first event category.
                </p>

                <a href="/categories/create" class="btn-create-category empty-btn">
                    Create First Category
                </a>
            </div>
        <% } else { %>

            <div class="category-grid">
                <% categories.forEach(category => { %>
                    <div class="category-card">

                        <div class="category-card-header">
                            <div class="category-icon">🏷️</div>

                            <span class="category-badge">
                                Category
                            </span>
                        </div>

                        <h2><%= category.name %></h2>

                        <p>
                            <%= category.description || 'No description added for this category.' %>
                        </p>

                        <div class="category-actions">
                            <a href="/categories/edit/<%= category._id %>" class="btn-category-edit">
                                Edit
                            </a>

                            <form
                                action="/categories/delete/<%= category._id %>"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this category?');"
                            >
                                <button type="submit" class="btn-category-delete">
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>
                <% }) %>
            </div>

        <% } %>

    </section>
</main>

<%- include('../partials/footer') %>