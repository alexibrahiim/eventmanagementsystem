<%- include('../partials/header') %>

<main class="users-page">
    <section class="users-shell">

        <div class="page-hero users-hero">
            <div>
                <span class="eyebrow">Admin Panel</span>
                <h1>Users</h1>
                <p>
                    Manage system users, view their roles, update account information, and control user access.
                </p>
            </div>

            <a href="/users/create" class="btn-create-user">
                + Create User
            </a>
        </div>

        <div class="user-stats-grid">
            <div class="user-stat-card">
                <span>Total Users</span>
                <strong><%= totalUsers %></strong>
            </div>

            <div class="user-stat-card">
                <span>Admins</span>
                <strong><%= adminCount %></strong>
            </div>

            <div class="user-stat-card">
                <span>Normal Users</span>
                <strong><%= normalUserCount %></strong>
            </div>
        </div>

        <% if (users.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">👤</div>
                <h2>No Users Found</h2>
                <p>
                    Start by creating the first user account.
                </p>

                <a href="/users/create" class="btn-create-user empty-btn">
                    Create First User
                </a>
            </div>
        <% } else { %>

            <div class="premium-table-card users-table-card">
                <table class="premium-table users-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">
                                            <%= user.name.charAt(0).toUpperCase() %>
                                        </div>

                                        <div>
                                            <strong><%= user.name %></strong>
                                            <span>ID: <%= user._id.toString().slice(-6) %></span>
                                        </div>
                                    </div>
                                </td>

                                <td><%= user.email %></td>

                                <td>
                                    <span class="role-badge <%= user.role === 'admin' ? 'admin-role' : 'user-role' %>">
                                        <%= user.role %>
                                    </span>
                                </td>

                                <td>
                                    <%= user.createdAt.toDateString() %>
                                </td>

                                <td>
                                    <div class="user-actions">
                                        <a href="/users/<%= user._id %>" class="btn-user-view">
                                            View
                                        </a>

                                        <a href="/users/edit/<%= user._id %>" class="btn-user-edit">
                                            Edit
                                        </a>

                                        <% if (currentUser && currentUser._id.toString() !== user._id.toString()) { %>
                                            <form
                                                action="/users/delete/<%= user._id %>"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this user? This will also remove their registrations.');"
                                            >
                                                <button type="submit" class="btn-user-delete">
                                                    Delete
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="self-user-label">
                                                Current Admin
                                            </span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } %>

    </section>
</main>

<%- include('../partials/footer') %>